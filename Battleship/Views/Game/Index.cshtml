@model Battleship.Models.GameState
@{
    ViewData["Title"] = "Battleship";
}
<audio id="cannon-sound" src="~/sounds/cannon.mp3" preload="auto"></audio>
<div class="row">
    <div class="col-md-6">
        <h2>Your Board</h2>
        <div class="board">
            @for (int i = 0; i < Battleship.Models.GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < Battleship.Models.GameBoard.Size; j++)
                    {
                        var cellInfo = Model.PlayerBoard.GetCellDisplay(i, j);
                        <div class="cell">
                            <div class="@cellInfo.BackgroundClass"></div>
                            <div class="@cellInfo.ShipClass"></div>
                            <div class="@cellInfo.MarkerClass"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <h2>Computer's Board</h2>
        <div class="board">
            @for (int i = 0; i < Battleship.Models.GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < Battleship.Models.GameBoard.Size; j++)
                    {
                        var cellInfo = Model.ComputerBoard.GetCellDisplay(i, j, true);
                        <form asp-action="Attack" asp-controller="Game" method="post" onsubmit="return playSound(event, this);">
                            <input type="hidden" name="row" value="@i" />
                            <input type="hidden" name="col" value="@j" />
                            <button type="submit" class="cell">
                                <div class="@cellInfo.BackgroundClass"></div>
                                <div class="@cellInfo.ShipClass"></div>
                                <div class="@cellInfo.MarkerClass"></div>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12 text-center">
        <h3>@Model.Message</h3>
        @if (Model.IsGameOver)
        {
            <a asp-action="NewGame" class="btn btn-primary">Play Again</a>
        }
    </div>
</div>

<script>
    function playSound(event, form) {
        event.preventDefault();
        var audio = document.getElementById('cannon-sound');
        audio.play();

        // Submit the form after a short delay to allow sound to play
        setTimeout(function() {
            form.submit();
        }, 300); // 300ms delay - adjust as needed

        return false;
    }
</script>