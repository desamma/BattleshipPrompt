@model Battleship.Models.TwoPlayerGameState

@{    ViewData["Title"] = "Battleship - Two Player";}

<div class="row">
    <div class="col-md-6">
        <h2>Player 1's Board</h2>
        <div class="board">
            @for (int i = 0; i < GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < GameBoard.Size; j++)
                    {
                        <div class="cell @Model.Player1Board.GetCellClass(i, j)"></div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <h2>Player 2's Board</h2>
        <div class="board">
            @for (int i = 0; i < GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < GameBoard.Size; j++)
                    {
                        <form asp-action="Attack" asp-controller="TwoPlayerGame" method="post">
                            <input type="hidden" name="row" value="@i" />
                            <input type="hidden" name="col" value="@j" />
                            <button type="submit" class="cell @Model.Player2Board.GetCellClass(i, j, true)"></button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (Model.IsShipPlacementPhase)
{
    <div class="row">
        <div class="col-md-12 text-center">
            <h3>Place Your Ships</h3>
            <form asp-action="PlaceShip" asp-controller="TwoPlayerGame" method="post">
                <div class="form-group">
                    <label for="row">Row:</label>
                    <input type="number" name="row" min="0" max="@(GameBoard.Size - 1)" required />
                </div>
                <div class="form-group">
                    <label for="col">Column:</label>
                    <input type="number" name="col" min="0" max="@(GameBoard.Size - 1)" required />
                </div>
                <div class="form-group">
                    <input type="radio" name="isHorizontal" value="true" checked /> Horizontal
                    <input type="radio" name="isHorizontal" value="false" /> Vertical
                </div>
                <button type="submit" class="btn btn-primary">Place Ship</button>
            </form>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-12 text-center">
        <h3>@Model.Message</h3>
        @if (Model.IsGameOver)
        {
            <a asp-action="NewGame" class="btn btn-primary">Play Again</a>
        }
    </div>
</div>
