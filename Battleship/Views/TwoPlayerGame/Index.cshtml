@model Battleship.Models.TwoPlayerGameState

@{    ViewData["Title"] = "Battleship - Two Player";}

<audio id="cannon-sound" src="/sounds/cannon.mp3" preload="auto"></audio>

<div class="row">
    <div class="col-md-6">
        <h2>Player 1's Board</h2>
        <div class="board">
            @for (int i = 0; i < Battleship.Models.GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < Battleship.Models.GameBoard.Size; j++)
                    {
                        var cellInfo = Model.Player1Board.GetCellDisplay(i, j, Model.IsPlayer1Turn);
                        if (!Model.IsPlayer1Turn)
                        {
                            <form asp-action="Attack" asp-controller="TwoPlayerGame" method="post" onsubmit="document.getElementById('cannon-sound').play();">
                                <input type="hidden" name="row" value="@i" />
                                <input type="hidden" name="col" value="@j" />
                                <button type="submit" class="cell">
                                    <div class="@cellInfo.BackgroundClass"></div>
                                    <div class="@cellInfo.ShipClass"></div>
                                    <div class="@cellInfo.MarkerClass"></div>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="cell">
                                <div class="@cellInfo.BackgroundClass"></div>
                                <div class="@cellInfo.ShipClass"></div>
                                <div class="@cellInfo.MarkerClass"></div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <h2>Player 2's Board</h2>
        <div class="board">
            @for (int i = 0; i < Battleship.Models.GameBoard.Size; i++)
            {
                <div class="row">
                    @for (int j = 0; j < Battleship.Models.GameBoard.Size; j++)
                    {
                        var cellInfo = Model.Player2Board.GetCellDisplay(i, j, !Model.IsPlayer1Turn);
                        if (Model.IsPlayer1Turn)
                        {
                            <form asp-action="Attack" asp-controller="TwoPlayerGame" method="post" onsubmit="document.getElementById('cannon-sound').play();">
                                <input type="hidden" name="row" value="@i" />
                                <input type="hidden" name="col" value="@j" />
                                <button type="submit" class="cell">
                                    <div class="@cellInfo.BackgroundClass"></div>
                                    <div class="@cellInfo.ShipClass"></div>
                                    <div class="@cellInfo.MarkerClass"></div>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="cell">
                                <div class="@cellInfo.BackgroundClass"></div>
                                <div class="@cellInfo.ShipClass"></div>
                                <div class="@cellInfo.MarkerClass"></div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 text-center">
        <h3>@Model.Message</h3>
        @if (Model.IsGameOver)
        {
            <a asp-action="NewGame" class="btn btn-primary">Play Again</a>
        }
        else
        {
            <a asp-action="NewGame" class="btn btn-danger" onclick="return confirm('Are you sure you want to reset the game?');">Reset Game</a>
        }
    </div>
</div>
